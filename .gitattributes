# Line endings: source and lifecycle scripts must stay LF.
* text=auto eol=lf
*.sh    text eol=lf
*.bash  text eol=lf
*.ps1   text eol=crlf
fnpack/cmd/*    text eol=lf
fnpack/wizard/* text eol=lf
fnpack/config/* text eol=lf
scripts/*       text eol=lf

# Binary assets
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.gif    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.db     binary
*.tar    binary
*.tar.gz binary
*.gz     binary
*.fpk    binary
*.exe    binary
