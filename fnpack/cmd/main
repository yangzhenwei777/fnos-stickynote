#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# 数据目录
DATA_DIR="${TRIM_PKGVAR}/data"
UPLOAD_DIR="${TRIM_PKGVAR}/upload"
WEB_DIR="${TRIM_APPDEST}/www"

# 共享目录 (飞牛环境变量)
# ⚠️ v21.57 P5 审计说明：-share-dirs 为**历史兼容死参数**，后端 config.go 明确标注从不消费，
#    当前版本不参与任何实际文件访问授权。仅保留接收以兼容 fnOS 启动命令 ABI。
# TRIM_DATA_SHARE_PATHS 格式: /path/to/share1:/path/to/share2

# 确保目录存在
mkdir -p "${DATA_DIR}" "${UPLOAD_DIR}"

# 端口二次校验：wizard 层已限制 1024-65535，此处兜底防御——
# v21.99：默认端口改为 13389；空值、非数字或越界一律回退默认端口，避免无效端口导致应用无法启动
case "${wizard_app_port}" in
    ''|*[!0-9]*)
        wizard_app_port=13389
        ;;
    *)
        if [ "${wizard_app_port}" -lt 1024 ] || [ "${wizard_app_port}" -gt 65535 ]; then
            wizard_app_port=13389
        fi
        ;;
esac

# 构建共享目录参数
SHARE_DIRS_PARAM="${TRIM_DATA_SHARE_PATHS}"
if [ -n "${TRIM_DATA_ACCESSIBLE_PATHS}" ]; then
    if [ -n "${SHARE_DIRS_PARAM}" ]; then
        SHARE_DIRS_PARAM="${SHARE_DIRS_PARAM}:${TRIM_DATA_ACCESSIBLE_PATHS}"
    else
        SHARE_DIRS_PARAM="${TRIM_DATA_ACCESSIBLE_PATHS}"
    fi
fi

# 构建启动参数数组（避免字符串拼接 + bash -c 二次解释）
# v2.2.0 统一网关模式：-socket 启用 unix socket 监听（${TRIM_APPDEST}/app.sock），
# 飞牛网关经此转发（gatewaySocket/gatewayPrefix 见 ui/config）；TCP -port 双轨保留
# （WebDAV 第三方客户端 / 局域网直连 / 桌面端依赖），二者共享同一 router。
ARGS=(-port="${wizard_app_port}" -socket="${TRIM_APPDEST}/app.sock" -web-dir="${WEB_DIR}" -data-dir="${DATA_DIR}" -upload-dir="${UPLOAD_DIR}")
if [ -n "${SHARE_DIRS_PARAM}" ]; then
    ARGS+=(-share-dirs="${SHARE_DIRS_PARAM}")
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

log_msg "应用目录：${TRIM_APPDEST}；"
log_msg "端口：${wizard_app_port}；"
log_msg "网关socket：${TRIM_APPDEST}/app.sock；"
log_msg "web目录：${WEB_DIR}；"
log_msg "数据目录：${DATA_DIR}；"
log_msg "上传目录：${UPLOAD_DIR}；"
log_msg "共享目录：${SHARE_DIRS_PARAM}；"

# Supervisor PID 文件（v20.8 审计优化）：用于 stop 时先停 supervisor 再停业务进程
SUPERVISOR_PID_FILE="${TRIM_PKGVAR}/supervisor.pid"

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting supervisor ..."
    # info.log 大小轮转（v18）：超 10MB 改名 .1，只保留最近 2 份，
    # 防 7x24 长跑把 NAS 存储撑满（Go 侧业务日志已按天轮转+30 天自清，此处针对进程 stdout 兜底）
    if [ -f "${LOG_FILE}" ] && [ "$(stat -c%s "${LOG_FILE}" 2>/dev/null || echo 0)" -gt 10485760 ]; then
        mv -f "${LOG_FILE}" "${LOG_FILE}.1"
        log_msg "info.log 已轮转（>10MB）"
    fi
    # Supervisor 循环（v20.8 审计优化）：进程崩溃自动重启，非 0 退出等 3s 再拉，
    # exit 0 视为正常退出不重启。
    (
        cd "${TRIM_APPDEST}/server/"
        while true; do
            nohup "${TRIM_APPDEST}/server/sticky-note" "${ARGS[@]}" >> "${LOG_FILE}" 2>&1 &
            STICKY_NOTE_PID=$!
            printf "%s" "$STICKY_NOTE_PID" > "${PID_FILE}"
            log_msg "Process started, pid=${STICKY_NOTE_PID}"
            wait $STICKY_NOTE_PID
            rc=$?
            log_msg "Process exited with code ${rc}"
            [ $rc -eq 0 ] && break
            log_msg "Restarting in 3s..."
            sleep 3
        done
    ) &
    printf "%s" "$!" > "${SUPERVISOR_PID_FILE}"
    log_msg "Supervisor started, pid=$!"
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    STICKY_NOTE_BIN="${TRIM_APPDEST}/server/sticky-note"

    # 先停止 supervisor（v20.8 审计优化），防止 kill 业务进程后被 supervisor 自动拉回
    # v21.57 P3：supervisor PID 也做身份校验（cmdline 应含本应用 server 目录）
    if [ -r "${SUPERVISOR_PID_FILE}" ]; then
        svpid=$(head -n 1 "${SUPERVISOR_PID_FILE}" | tr -d '[:space:]')
        if check_process "${svpid}" "${TRIM_APPDEST}/server/"; then
            log_msg "send TERM to supervisor PID:${svpid}"
            kill -TERM "${svpid}" >> "${LOG_FILE}" 2>&1
        else
            log_msg "supervisor PID ${svpid} 非本应用进程或已退出，跳过 kill"
        fi
        rm -f "${SUPERVISOR_PID_FILE}"
    fi

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        log_msg "pid=${pid}"
        if ! check_process "${pid}" "${STICKY_NOTE_BIN}"; then
            # process not exist（或 PID 复用被身份校验拦截），delete pidfile
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1 (进程不存在或身份不匹配)"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
    kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}" "${STICKY_NOTE_BIN}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    local expected=$2  # 可选：期望的可执行路径（如 ${TRIM_APPDEST}/server/sticky-note）
    if ! kill -0 "${pid}" 2>/dev/null; then
        return 1  # process not exist
    fi
    # v21.57 P3 审计修复：kill 前校验进程身份——防止 PID 复用误杀宿主机其他进程。
    # /proc/<pid>/cmdline 可用时比对期望路径；不可用（非 Linux）退化为 kill -0 存在性检查。
    if [ -n "${expected}" ] && [ -r "/proc/${pid}/cmdline" ]; then
        if tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -Fq -- "${expected}"; then
            return 0  # 确认为本应用进程
        else
            return 1  # PID 存在但非本应用 → 拒绝操作（防误杀）
        fi
    fi
    return 0  # 进程存在（无身份要求或 /proc 不可用）
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        # v21.90 P1（N-10/M-08 审计核对）：status 同样传入期望二进制路径做身份校验——
        # 此前只 kill -0，PID 被系统复用给其他进程时会误报"运行中"，
        # 导致 start_process 直接 return、应用实际已死却无法拉起（可用性缺陷）。
        # 与 stop_process 的 v21.57 P3 身份校验对齐。
        if check_process "${pid}" "${TRIM_APPDEST}/server/sticky-note"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
healthcheck)
    # 通过后端 /api/health 判断应用真实健康度（含数据库连通性）
    PORT="${wizard_app_port}"
    [ -z "${PORT}" ] && PORT=13389
    RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "http://127.0.0.1:${PORT}/api/health" 2>/dev/null)
    if [ "${RESPONSE}" = "200" ]; then
        echo "healthy"
        exit 0
    else
        echo "unhealthy (HTTP ${RESPONSE})"
        exit 1
    fi
    ;;
*)
    exit 1
    ;;
esac
